# GEMINI_API_KEY: Optional Gemini API key if AI assistance is enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Default: 3000)
PORT=3000

# Authentication & Session JWT Secret (Set a strong 32+ char secret in production)
JWT_SECRET="aegis-remote-super-secure-production-key-change-me-32b"

# WebRTC STUN/TURN Server Configuration
STUN_SERVER_URL="stun:stun.l.google.com:19302"
TURN_SERVER_URL=""
TURN_SERVER_USERNAME=""
TURN_SERVER_CREDENTIAL=""

# Maximum upload file size in bytes (100MB default)
MAX_FILE_TRANSFER_BYTES=104857600
