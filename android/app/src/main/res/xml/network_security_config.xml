<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default enforce TLS/HTTPS and encrypted WebSockets WSS. In debug builds, local IP testing is permitted -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
